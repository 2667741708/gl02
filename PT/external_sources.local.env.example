# 炉次仪表盘多数据源本机配置模板
# 复制为 external_sources.local.env 后填写；真实文件已由 .gitignore 排除。
# 不要把真实账号、密码、Cookie 或会话编号提交到仓库。

# GL02 PostgreSQL 传感器镜像
GL02_PGHOST=127.0.0.1
GL02_PGPORT=5432
GL02_PGDATABASE=bf_trend
GL02_PGUSER=
GL02_PGPASSWORD=
BF_DB_CONNECT_TIMEOUT_SECONDS=2

# Vastbase 生产作业权限面
IMES_OPS_DB_HOST=127.0.0.1
IMES_OPS_DB_PORT=15433
IMES_OPS_DB_NAME=vastbase
IMES_OPS_DB_USER=
IMES_OPS_DB_PASSWORD=

# Vastbase 化验权限面
IMES_LAB_DB_HOST=127.0.0.1
IMES_LAB_DB_PORT=15433
IMES_LAB_DB_NAME=vastbase
IMES_LAB_DB_USER=
IMES_LAB_DB_PASSWORD=
IMES_DB_CONNECT_TIMEOUT_SECONDS=3

# IMES Web（登录仍需要当前验证码，或由现场提供有效 JSESSIONID）
IMES_WEB_URL=http://10.10.181.209:8080/imes.web/
IMES_WEB_USER=
IMES_WEB_PASSWORD=
IMES_WEB_JSESSIONID=

# pSpace SDK 与 8770 实时只读桥
PSPACE_SERVER=10.22.181.243
PSPACE_PORT=8889
PSPACE_USER=
PSPACE_PASSWORD=
PSPACE_SDK_ROOT=
PSPACE_WS_URL=ws://127.0.0.1:8770
