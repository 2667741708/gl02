    "write_mode": "upsert_by_tag_and_timestamp"
  },
  "state_materialization": {
    "enabled": true,
    "semantic_version": "bounded_state_hold_v1",
    "scope": "realtime_windows_up_to_2_hours",
    "note": "原始点位无新样本时按有限时长逐分钟保持；保持记录标记PS_STATE_HOLD/Held，不冒充pSpace原始采样，新原始值到达后同分钟覆盖。",
    "policies": [
      {
        "name": "furnace_body_temperature",
        "variable_prefix": "T_body_",
        "maximum_hold_minutes": 20
      },
      {
        "name": "cooling_minute_state",
        "variables": ["Q_soft_water", "P_soft_water", "Q_high_pressure_water", "P_high_pressure_water", "P_medium_pressure_water"],
        "maximum_hold_minutes": 10
      },
      {
        "name": "expansion_tank_hourly_state",
        "variables": ["ExpansionTankLevel"],
        "maximum_hold_minutes": 70
      },
      {
        "name": "burden_line_probe_state",
        "variables": ["L_north", "L_south"],
        "maximum_hold_minutes": 10
      },
      {
        "name": "top_temperature_pressure_state",
        "variables": ["T_top_A", "T_top_B", "T_top_C", "T_top_D", "P_top_A", "P_top_B", "P_top_C", "P_top_D"],
        "maximum_hold_minutes": 10
      },
      {
        "name": "circumferential_static_pressure_state",
        "variable_prefix": "P_static_",
        "maximum_hold_minutes": 10
      }
    ]
  },
  "derived": {
    "T_top": {
      "method": "avg",
      "sources": ["T_top_A", "T_top_B", "T_top_C", "T_top_D"],
